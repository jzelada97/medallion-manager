{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Messages Consumed (msg/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(hr_etl_messages_consumed_total[1m]))",
          "legendFormat": "total msg/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    },
    {
      "title": "Persons Persisted (total)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "hr_etl_persons_persisted_total",
          "legendFormat": "persisted",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "title": "Consolidations (total)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "hr_etl_consolidations_total",
          "legendFormat": "consolidations",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "title": "Messages by Fragment Type (msg/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(hr_etl_messages_consumed_total[1m])",
          "legendFormat": "{{fragment_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    },
    {
      "title": "Failed Messages (total)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "hr_etl_messages_failed_total",
          "legendFormat": "failed",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}] } }
      }
    },
    {
      "title": "Pending Fragments in Redis",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "targets": [
        {
          "expr": "hr_etl_pending_fragments",
          "legendFormat": "pending",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "max": 10000 }
      }
    },
    {
      "title": "Processing Time (p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(hr_etl_processing_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99 processing",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(hr_etl_persist_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99 persist",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "title": "Consolidation Rate (per sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "rate(hr_etl_consolidations_total[1m])",
          "legendFormat": "consolidations/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["hr-etl"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "title": "HR ETL Pipeline",
  "uid": "hr-etl-pipeline",
  "version": 1
}
