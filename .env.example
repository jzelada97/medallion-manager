# === Kafka (servidor externo del profesor - caja negra) ===
KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:29092  # En Docker Desktop usar host.docker.internal:29092
KAFKA_TOPIC=probando
KAFKA_GROUP_ID=hr-etl-consumer
KAFKA_AUTO_OFFSET_RESET=earliest

# === MongoDB (Data Lake) ===
MONGO_ROOT_USER=<mongo_root_user>        # usado por el container mongo
MONGO_ROOT_PASSWORD=<mongo_root_password> # usado por el container mongo
MONGO_URI=mongodb://<mongo_root_user>:<mongo_root_password>@mongo:27017/
MONGO_DB=hr_lake
MONGO_RAW_COLLECTION=raw_messages

# === PostgreSQL (Data Warehouse) ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hr_warehouse
POSTGRES_USER=<postgres_user>
POSTGRES_PASSWORD=<postgres_password>

# === Redis (caché / buffer de matching) ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<redis_password>
REDIS_BUFFER_TTL=300

# === App ===
LOG_LEVEL=INFO
CONSOLIDATION_MIN_FRAGMENTS=2
API_HOST=0.0.0.0
API_PORT=8000
# MAX_RECORDS=500  # descomenta para limitar la ingesta en modo demo/prueba (omitir = infinito)

# === Airflow (opcional, solo si levantas docker-compose.airflow.yml) ===
# Airflow lee las mismas credenciales de arriba (POSTGRES_*, MONGO_URI, REDIS_PASSWORD).
# Solo necesita saber el nombre real de la red del stack principal, que depende del
# nombre de la carpeta del repo: <carpeta>_hr_net.
#   - En local (carpeta Proyecto1_modulo3_DE2): proyecto1_modulo3_de2_hr_net
#   - En la VM (carpeta hr-etl):                hr-etl_hr_net
# Descubre el tuyo con:  docker network ls | grep hr_net
HR_NET_NAME=proyecto1_modulo3_de2_hr_net
