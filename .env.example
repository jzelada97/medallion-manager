# === Kafka (servidor externo del profesor - caja negra) ===
KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:29092  # En Docker Desktop usar host.docker.internal:29092
KAFKA_TOPIC=probando
KAFKA_GROUP_ID=hr-etl-consumer
KAFKA_AUTO_OFFSET_RESET=earliest

# === MongoDB (Data Lake) ===
MONGO_ROOT_USER=<mongo_root_user>        # usado por el container mongo
MONGO_ROOT_PASSWORD=<mongo_root_password> # usado por el container mongo
MONGO_URI=mongodb://<mongo_root_user>:<mongo_root_password>@mongo:27017/
MONGO_DB=hr_lake
MONGO_RAW_COLLECTION=raw_messages

# === PostgreSQL (Data Warehouse) ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hr_warehouse
POSTGRES_USER=<postgres_user>
POSTGRES_PASSWORD=<postgres_password>

# === Redis (caché / buffer de matching) ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<redis_password>
REDIS_BUFFER_TTL=300

# === App ===
LOG_LEVEL=INFO
CONSOLIDATION_MIN_FRAGMENTS=2
API_HOST=0.0.0.0
API_PORT=8000
# MAX_RECORDS=500  # descomenta para limitar la ingesta en modo demo/prueba (omitir = infinito)

# === Asistente Virtual (Experto++) ===
GROQ_API_KEY=gsk_...           # Clave de Groq — free tier en console.groq.com (NUNCA subir al repo)
GROQ_MODEL=openai/gpt-oss-120b # Modelo con tool calling disponible en el free tier
# LLM_TEMPERATURE=0.1          # Temperatura baja para respuestas deterministas
# LLM_MAX_TOKENS=1024           # Límite de tokens por respuesta
# ASSISTANT_MAX_TOOL_CALLS=4    # Máximo de herramientas por turno (evita bucles)
API_URL=http://localhost:8000  # URL de la API FastAPI (en Docker: http://api:8000)
