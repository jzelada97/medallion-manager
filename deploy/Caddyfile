# Caddy reverse proxy for the HR Insights ETL demo on an Oracle VM.
# {$DOMAIN} is injected from the environment (see docker-compose.prod.yml).
# Caddy automatically provisions and renews HTTPS certificates via Let's Encrypt.

# Frontend (Streamlit) at the root domain.
{$DOMAIN} {
	encode gzip

	# Redirect the bare /grafana (no trailing slash) to /grafana/ so users who
	# type it without the slash don't fall through to Streamlit.
	redir /grafana /grafana/

	# Grafana (optional) under /grafana.
	# Use `handle` (not `handle_path`) so the /grafana prefix is preserved when
	# proxied. Grafana runs with GF_SERVER_SERVE_FROM_SUB_PATH=true and a root_url
	# ending in /grafana/, so it expects to keep the prefix. Stripping it (as
	# handle_path does) makes Grafana redirect back to /grafana/, causing an
	# infinite redirect loop (ERR_TOO_MANY_REDIRECTS).
	handle /grafana/* {
		reverse_proxy grafana:3000
	}

	# Everything else -> Streamlit frontend.
	reverse_proxy frontend:8501
}

# API (FastAPI) at api.<domain>.
api.{$DOMAIN} {
	encode gzip
	reverse_proxy api:8000
}
